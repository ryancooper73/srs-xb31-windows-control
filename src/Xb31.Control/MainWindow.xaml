<Window x:Class="Xb31.Control.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:viewModels="clr-namespace:Xb31.Control.ViewModels"
        Title="SRS-XB31 Control"
        Icon="Assets/Xb31Control.ico"
        Width="440"
        Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Loaded="WindowLoaded"
        Closing="WindowClosing"
        Background="{StaticResource ObsidianBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI">
  <Window.Style>
    <Style TargetType="{x:Type Window}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsBusy}" Value="True">
          <Setter Property="Cursor" Value="Wait" />
          <Setter Property="ForceCursor" Value="True" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Style>
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        CornerRadius="0"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Border BorderBrush="#6637E5FF" BorderThickness="1" CornerRadius="12">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource ObsidianColor}" />
        <GradientStop Offset="0.58" Color="#FF0B1020" />
        <GradientStop Offset="1" Color="#FF151026" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="36" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0"
            Margin="12,4,8,4"
            Background="Transparent"
            MouseLeftButtonDown="TitleBarMouseDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Rectangle Width="12" Height="2" Fill="{StaticResource VioletBrush}" />
          <TextBlock Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="10"
                     FontWeight="SemiBold"
                     Text="XB31 CONTROL" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button AutomationProperties.Name="Minimize window"
                  Content="−"
                  Style="{StaticResource TitleBarButtonStyle}"
                  ToolTip="Minimize"
                  Click="MinimizeClicked" />
          <Button x:Name="CloseWindowButton"
                  AutomationProperties.Name="Close window"
                  Content="×"
                  Style="{StaticResource TitleBarButtonStyle}"
                  ToolTip="Close"
                  Click="CloseClicked" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="28">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="22" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="18" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
          <TextBlock Text="SRS-XB31"
                     FontSize="24"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                    <Setter Property="Opacity" Value="1" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:DeviceState.Connecting}">
                        <Setter Property="Fill" Value="{StaticResource VioletBrush}" />
                        <DataTrigger.EnterActions>
                          <BeginStoryboard x:Name="ConnectingPulse">
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                              <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                               From="1"
                                               To="0.3"
                                               Duration="0:0:0.7" />
                            </Storyboard>
                          </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                          <RemoveStoryboard BeginStoryboardName="ConnectingPulse" />
                        </DataTrigger.ExitActions>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:DeviceState.Available}">
                        <Setter Property="Fill" Value="{StaticResource CyanBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:DeviceState.Unavailable}">
                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding State}" Value="{x:Static viewModels:DeviceState.CommandFailed}">
                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Margin="8,0,0,0"
                         Style="{StaticResource StatusTextStyle}"
                         Text="{Binding StatusText}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <TextBlock Margin="0,0,6,0"
                         Foreground="{StaticResource MutedBrush}"
                         Text="Battery:" />
              <TextBlock Foreground="{StaticResource TextBrush}"
                         Text="{Binding BatteryText}" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2">
          <TextBlock Style="{StaticResource SectionLabelStyle}" Text="LIGHTING" />
          <Grid Margin="0,8,0,0">
            <ComboBox x:Name="LightingSelector"
                      AutomationProperties.Name="Lighting mode"
                      DisplayMemberPath="Name"
                      IsEnabled="{Binding CanInteract}"
                      ItemsSource="{Binding LightingOptions}"
                      SelectedItem="{Binding SelectedLighting, Mode=TwoWay}"
                      SelectionChanged="LightingSelectionChanged" />
            <TextBlock Margin="14,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"
                       IsHitTestVisible="False"
                       Text="Select lighting mode">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ElementName=LightingSelector, Path=SelectedItem}"
                                 Value="{x:Null}">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Grid>
          <TextBlock Margin="0,8,0,0"
                     Foreground="{StaticResource MutedBrush}"
                     Text="{Binding LastLightingText}" />
        </StackPanel>

        <StackPanel Grid.Row="4">
          <TextBlock Style="{StaticResource SectionLabelStyle}" Text="SOUND" />
          <ComboBox x:Name="SoundSelector"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="Sound mode"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding CanInteract}"
                    ItemsSource="{Binding SoundOptions}"
                    SelectedValue="{Binding SelectedSoundMode, Mode=TwoWay}"
                    SelectedValuePath="Mode"
                    SelectionChanged="SoundSelectionChanged" />
          <TextBlock Margin="0,8,0,0"
                     Foreground="{StaticResource MutedBrush}"
                     Text="{Binding SoundStatusText}" />
        </StackPanel>

        <StackPanel Grid.Row="6">
          <TextBlock Style="{StaticResource SectionLabelStyle}" Text="AUTO STANDBY" />
          <ComboBox x:Name="AutoStandbySelector"
                    Margin="0,8,0,0"
                    AutomationProperties.Name="Auto standby"
                    DisplayMemberPath="Name"
                    IsEnabled="{Binding CanInteract}"
                    ItemsSource="{Binding AutoStandbyOptions}"
                    SelectedValue="{Binding SelectedAutoStandby, Mode=TwoWay}"
                    SelectedValuePath="IsOn"
                    SelectionChanged="AutoStandbySelectionChanged" />
          <TextBlock Margin="0,8,0,0"
                     Foreground="{StaticResource MutedBrush}"
                     Text="{Binding AutoStandbyStatusText}" />
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Margin="0,10,0,10"
                    VerticalAlignment="Bottom">
          <CheckBox x:Name="SyncLightingCheckBox"
                    Content="Sync lighting with display"
                    Foreground="{StaticResource TextBrush}"
                    Checked="SyncLightingChecked"
                    Unchecked="SyncLightingUnchecked" />
          <CheckBox x:Name="StartWithWindowsCheckBox"
                    Margin="0,6,0,0"
                    Content="Start XB31 Control with Windows"
                    Foreground="{StaticResource TextBrush}"
                    Checked="StartWithWindowsChecked"
                    Unchecked="StartWithWindowsUnchecked" />
        </StackPanel>

        <Button Grid.Row="8"
                AutomationProperties.Name="Power off speaker"
                Content="Power Off"
                IsEnabled="{Binding CanInteract}"
                Click="PowerOffClicked" />
      </Grid>
    </Grid>
  </Border>
</Window>
